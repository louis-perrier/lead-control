# Copy to .env and fill in. Never commit the filled file.

# Supabase project, found under Project Settings, API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the Edge Functions that run the long jobs
VITE_SCRAPING_EDGE_URL=

# Meta app id, used by the Instagram OAuth return
VITE_META_APP_ID=

# Key of the in app feedback endpoint
VITE_FEEDBACK_KEY=
